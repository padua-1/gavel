import crypto from 'node:crypto';
import { InlineKeyboard } from 'grammy';
import { catalog } from './catalog.js';
import { config } from './config.js';
import { db, OrderRow } from './db.js';
import { assessOrder } from './guard.js';
import { notify } from './notify.js';
import { createOrder, createSubscription } from './paypal.js';

export interface OrderResult {
  status: 'awaiting_payment' | 'held' | 'declined' | 'error';
  message: string;
  checkoutUrl?: string;
}

// Buyer asks to buy something: scam-guard rules on it first.
export async function placeOrder(chatId: number, sku: string, recentMessages: string[]): Promise<OrderResult> {
  const item = catalog.find((i) => i.sku === sku);
  if (!item) return { status: 'error', message: `Unknown item: ${sku}` };
  if (item.planId !== undefined) return { status: 'error', message: 'That item is a subscription: use start_subscription.' };

  const assessment = await assessOrder({ chatId, item: item.name, amount: item.price, recentMessages });
  const id = crypto.randomUUID();
  db.prepare(
    `INSERT INTO orders (id, chat_id, item, amount, currency, status, risk_score, verdict, reasons)
     VALUES (?, ?, ?, ?, ?, 'pending_review', ?, ?, ?)`,
  ).run(id, chatId, item.name, item.price.toFixed(2), item.currency, assessment.score, assessment.verdict, JSON.stringify(assessment.reasons));

  if (assessment.verdict === 'block') {
    db.prepare(`UPDATE orders SET status = 'rejected' WHERE id = ?`).run(id);
    return { status: 'declined', message: 'The shop cannot take this order.' };
  }

  if (assessment.verdict === 'hold') {
    db.prepare(`UPDATE orders SET status = 'held' WHERE id = ?`).run(id);
    await notifyVendor(id, item.name, item.price, assessment.score, assessment.reasons);
    return { status: 'held', message: 'The order is waiting for the vendor to review it. You will get a message here.' };
  }

  return releaseOrder(id);
}

// Creates the PayPal order and hands back the checkout link. Used for auto-approved
// orders and when the vendor releases a held one.
export async function releaseOrder(orderId: string, opts: { notifyBuyer?: boolean } = {}): Promise<OrderResult> {
  const row = db.prepare(`SELECT * FROM orders WHERE id = ?`).get(orderId) as OrderRow | undefined;
  if (!row) return { status: 'error', message: 'Order not found.' };

  const pp = await createOrder({ amount: row.amount, currency: row.currency, description: row.item });
  db.prepare(`UPDATE orders SET status = 'awaiting_payment', paypal_order_id = ? WHERE id = ?`).run(pp.id, orderId);

  const result: OrderResult = {
    status: 'awaiting_payment',
    message: 'Order approved. Pay securely with PayPal using the checkout link.',
    checkoutUrl: pp.approveUrl,
  };
  if (opts.notifyBuyer) {
    await notify(row.chat_id, `Good news: your order for ${row.item} is approved. Pay here: ${pp.approveUrl}`);
  }
  return result;
}

export async function rejectOrder(orderId: string): Promise<void> {
  const row = db.prepare(`SELECT * FROM orders WHERE id = ?`).get(orderId) as OrderRow | undefined;
  if (!row) return;
  db.prepare(`UPDATE orders SET status = 'rejected' WHERE id = ?`).run(orderId);
  await notify(row.chat_id, `Sorry, the shop could not complete your order for ${row.item}.`);
}

export async function markPaid(paypalOrderId: string): Promise<void> {
  const row = db.prepare(`SELECT * FROM orders WHERE paypal_order_id = ?`).get(paypalOrderId) as OrderRow | undefined;
  if (!row || row.status === 'paid') return;
  db.prepare(`UPDATE orders SET status = 'paid' WHERE id = ?`).run(row.id);
  await notify(row.chat_id, `Payment received for ${row.item}. Thank you!`);
}

export async function startSubscription(chatId: number, sku: string): Promise<OrderResult> {
  const item = catalog.find((i) => i.sku === sku);
  if (!item?.planId) return { status: 'error', message: 'No subscription plan is configured for that item (run npm run setup:plans).' };

  // TODO: run scam-guard on subscription sign-ups too.
  const sub = await createSubscription(item.planId);
  db.prepare(
    `INSERT INTO subscriptions (id, chat_id, plan_id, name, amount, status) VALUES (?, ?, ?, ?, ?, 'APPROVAL_PENDING')`,
  ).run(sub.id, chatId, item.planId, item.name, item.price.toFixed(2));

  return {
    status: 'awaiting_payment',
    message: 'Approve the subscription with PayPal using the link.',
    checkoutUrl: sub.approveUrl,
  };
}
async function notifyVendor(orderId: string, item: string, amount: number, score: number, reasons: string[]) {
  if (!config.vendorChatId) {
    console.warn(`Order ${orderId} is held but VENDOR_CHAT_ID is not set`);
    return;
  }
  const text =
    `Held order: ${item} ($${amount.toFixed(2)})\n` +
    `Risk score: ${score}/100\n` +
    reasons.map((r) => `- ${r}`).join('\n');
  const keyboard = new InlineKeyboard().text('Release', `release:${orderId}`).text('Reject', `reject:${orderId}`);
  await notify(config.vendorChatId, text, { reply_markup: keyboard });
}
