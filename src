// Called once at startup, before anything talks to Telegram, Anthropic, or PayPal.
export function assertConfig(): void {
  const missing = [
    ['TELEGRAM_BOT_TOKEN', config.telegramToken],
    ['ANTHROPIC_API_KEY', config.anthropicKey],
    ['PAYPAL_CLIENT_ID', config.paypal.clientId],
    ['PAYPAL_CLIENT_SECRET', config.paypal.clientSecret],
  ]
    .filter(([, value]) => !value)
    .map(([name]) => name);
  if (missing.length) throw new Error(`Missing env vars: ${missing.join(', ')}`);
  if (!config.paypal.baseUrl.includes('sandbox')) {
    throw new Error('Gavel is sandbox-only for the hackathon: PAYPAL_BASE_URL must be the sandbox API.');
  }
}
