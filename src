// Tiny indirection so services can message Telegram users without importing the bot
// (the bot imports the agent, which imports the services: this avoids a cycle).
type Sender = (chatId: number, text: string, options?: unknown) => Promise<unknown>;

let sender: Sender | null = null;

export function registerSender(fn: Sender): void {
  sender = fn;
}

export async function notify(chatId: number, text: string, options?: unknown): Promise<void> {
  if (!sender) {
    console.warn('notify() called before the bot registered a sender');
    return;
  }
  await sender(chatId, text, options);
}
